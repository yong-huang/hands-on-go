  "cards": [
    {
      "dot": "cyan",
      "title": "为什么必须拷贝",
      "items": [
        "string 只读、[]byte 可写，语义冲突不能共用同一块内存",
        "所以双向转换各分配一次、各拷贝一次，代价 O(n)",
        "实测地址对：0x…8b7→0x…068 与 0x…078→0x…07a（地址每次运行不同）"
      ]
    },
    {
      "dot": "amber",
      "title": "高频转换的代价",
      "items": [
        "循环里反复 string↔[]byte 会放大分配压力，拖累 GC",
        "拼接大量字符串用 strings.Builder，只做一次拷贝",
        "确认只读可共用时才考虑 unsafe 零拷贝，且要非常谨慎"
      ]
    }
  ]
}