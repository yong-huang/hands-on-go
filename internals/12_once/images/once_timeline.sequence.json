    },
    {
      "id": "m4",
      "from": "once",
      "to": "callers",
      "y": 330,
      "label": "等锁的其余调用者全部放行",
      "variant": "return",
      "note": "实测慢路径平均等 28.9 ms（f 睡 30ms）"
    },
    {
      "id": "m5",
      "from": "callers",
      "to": "once",
