    },
    {
      "from": 375,
      "to": 465,
      "label": "f 已结束（done=1）：快路径直通"
    }
  ],
  "messages": [
    {
      "id": "m1",
      "from": "callers",
      "to": "once",
      "y": 195,
      "label": "并发 Do（同一瞬间）",
