  "cards": [
    {
      "dot": "cyan",
      "title": "心智模型",
      "items": [
        "Once = done 原子位（快路径判据）+ Mutex（慢路径串行化）",
        "快路径：一次原子 Load，无锁无等待，内联在每个调用点",
        "慢路径：抢 mutex → 再查 done → 跑 f → 返回后才 Store(true)"
      ]
    },
    {
      "dot": "emerald",
      "title": "实测（Go 1.26.5）",
      "items": [
        "exp1：100 个 goroutine 并发 Do，f 实际执行 1 次",
        "exp2：f 睡 30ms，4 个慢路径调用者平均等 28.9 ms",
        "exp2：之后的快路径调用只花 0.00 ms；exp3：16/16 看到 f 的副作用"
      ]
    },
    {
      "dot": "rose",
      "title": "错误实现",
      "items": [
        "CAS(false,true) 就执行：只保证「跑一次」",
        "不保证「所有 Do 返回时 f 已结束」——第二个调用者不等 f",
        "Mutex + f 返回后才置位，两个保证缺一不可"
      ]
    }
  ]
}