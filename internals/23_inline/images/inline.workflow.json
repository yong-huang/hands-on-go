{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "编译器内联决策：80 成本预算下的一次判定",
    "output": "images/inline.html",
    "quality_profile": "showcase",
    "locale": "zh-CN",
    "legend": {
      "mode": "hidden"
    }
  },
  "lanes": [
    {
      "id": "caller",
      "label": "调用点（你的代码）"
    },
    {
      "id": "decision",
      "label": "编译器内联决策（-gcflags=-m 可验证）"
    },
    {
      "id": "reject",
      "label": "拒绝内联（保持真调用 call）",
      "variant": "exception"
    }
  ],
  "mainPath": [
    "scan",
    "cost",
    "copy",
    "fold",
    "escape"
  ],
  "nodes": [
    {
      "id": "scan",
      "lane": "caller",
      "col": 0,
      "type": "frontend",
      "label": "扫描调用点",
      "sublabel": "遍历函数体中的每个 call",
      "width": 132
    },
    {
      "id": "cost",
      "lane": "decision",
      "col": 1,
      "type": "backend",
      "label": "成本评估",
      "sublabel": "预算 80 · 实测 2 / 16 / 56",
      "tag": "cost model",
      "width": 132
    },
    {
      "id": "copy",
      "lane": "decision",
      "col": 2,
      "type": "backend",
      "label": "拷贝函数体",
      "sublabel": "inlining call to …",
      "tag": "省 call / 传参",
      "width": 132
    },
    {
      "id": "fold",
      "lane": "decision",
      "col": 3,
      "type": "database",
      "label": "常量折叠",
      "sublabel": "acc += 42 → 42·n 循环消失",
      "width": 132
    },
    {
      "id": "escape",
      "lane": "decision",
      "col": 4,
      "type": "database",
      "label": "逃逸分析更准",
      "sublabel": "对象更容易留在栈上",
      "width": 132
    },
    {
      "id": "over",
      "lane": "reject",
      "col": 3,
      "type": "security",
      "label": "超预算拒绝",
      "sublabel": "benchSmall 186 · reflect 145",
      "tag": "保持真调用",
      "width": 132
    },
    {
      "id": "forced",
      "lane": "reject",
      "col": 4,
      "type": "security",
      "label": "禁用与硬规则",
      "sublabel": "//go:noinline · defer",
      "tag": "保持真调用",
      "width": 132
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "scan",
      "to": "cost",
      "label": "遇到候选函数",
      "variant": "default"
    },
    {
      "id": "e2",
      "from": "cost",
      "to": "copy",
      "label": "cost < 80",
      "variant": "emphasis"
    },
    {
      "id": "e3",
      "from": "copy",
      "to": "fold",
      "label": "解锁后续优化",
      "variant": "emphasis"
    },
    {
      "id": "e4",
      "from": "fold",
      "to": "escape",
      "variant": "emphasis"
    },
    {
      "id": "e5",
      "from": "cost",
      "to": "over",
      "label": "cost > 80",
      "role": "error",
      "variant": "dashed"
    },
    {
      "id": "e6",
      "from": "cost",
      "to": "forced",
      "label": "标记 / 硬规则",
      "role": "error",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "谁会被拒绝（go1.26 实测诊断）",
      "items": [
        "超预算：cannot inline benchSmall: cost 186 exceeds budget 80",
        "reflect.ValueOf 实测 cost 145，同样超预算被拒",
        "defer 无法内联：unhandled op DEFER；//go:noinline 显式禁用"
      ]
    },
    {
      "dot": "cyan",
      "title": "-gcflags=-m 验证注记",
      "items": [
        "go build -gcflags=-m main.go → can inline smallSum8 with cost 16",
        "-m -m 才报 cannot inline 的完整原因（单层 -m 只报 can）",
        "构建缓存命中后诊断为空，加 -a 强制全部重编再看"
      ]
    },
    {
      "dot": "emerald",
      "title": "红利与边界",
      "items": [
        "constForty 内联后 acc+=42 整个循环折叠成 42·n，实测约 4x",
        "bigLoop cost 56<80 也被内联，但函数体占主导、收益约 1.0x",
        "逃逸不挡内联：内联后逃逸分析在调用点统一判定，小对象更容易留在栈上"
      ]
    }
  ]
}