    {
      "dot": "cyan",
      "title": "三种模式实测（64×1MB，独立进程）",
      "items": [
        "leak：分配后 RSS 73MB，GC 三遍后 74MB —— 纹丝不动",
        "free：正确 C.free，RSS ≈10MB 回到基线",
        "go：堆峰值 64MB 交给 GC，RSS 平稳 ≈11MB",
        "RSS 每次运行 ±1MB 波动，结论不变"
      ]
    },
    {
      "dot": "rose",
      "title": "为什么 GC 管不了 C 内存",
      "items": [
        "GC 只遍历 Go 指针：栈/寄存器/全局 + Go 堆内指针",
        "C.malloc 的内存从不登记进 GC 对象集",
        "leak 模式 Go 堆峰值打印为 0（<1MB），RSS 却 73MB"
      ]
    },
    {
      "dot": "emerald",
      "title": "边界规则",
      "items": [
        "C 指针借给 Go 只读安全：peek(p, 0) 即是",
        "Go 指针长期借给 C 保存：被 checkptr / -race 拦",
        "C.CBytes / C.GoBytes：拷贝一次即完成所有权交接"
      ]
    }
  ]
