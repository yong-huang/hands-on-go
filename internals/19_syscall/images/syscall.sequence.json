{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "阻塞 syscall 时间线：M 蹲守内核，P 被移交，返回后取回或休眠",
    "output": "images/syscall.html",
    "quality_profile": "showcase",
    "locale": "zh-CN",
    "viewBox": [
      1060,
