  "cards": [
    {
      "dot": "cyan",
      "title": "为什么会误删",
      "items": [
        "C1 业务超过 TTL，锁已转手给 C2",
        "不校验 value 的 DEL 会删掉别人的锁",
        "互斥被破坏：C2 以为还持锁，C3 也能获锁"
      ]
    },
    {
      "dot": "rose",
      "title": "value 校验怎么防",
      "items": [
        "加锁时写入唯一 value（holder 标识）",
        "解锁用 Lua 原子执行 GET 比对 + DEL",
        "本实验用 holder 字段模拟该语义"
      ]
    },
    {
      "dot": "orange",
      "title": "根本缓解",
      "items": [
        "watchdog 后台续租，业务没跑完就延长 TTL",
        "TTL 不可省：持锁方崩溃时唯一防线",
        "更强保证需 Redlock 多数派或 etcd 租约"
      ]
    }
  ]
}