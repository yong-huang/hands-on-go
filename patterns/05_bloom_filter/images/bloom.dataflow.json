  "cards": [
    {
      "dot": "emerald",
      "title": "为什么不会漏判",
      "items": [
        "Add 过的元素把 k 个位全置 1，位只会从 0 变 1、永不清零",
        "再次查询时 k 个位必然仍为 1，MayContain 一定返回 true",
        "代价：别的元素可能把这些位也置 1，造成假阳性"
      ]
    },
    {
      "dot": "amber",
      "title": "实测参数与误判率",
      "items": [
        "演示过滤器：n=1000、m=10000 位（每元素 10 bit）、k=7",
        "大规模测试：插入 10000 元素后实测误判 432/10000 = 4.32%",
        "公式估计 0.82%——双重哈希相关性使实际误判高于理论值"
      ]
    }
  ]
