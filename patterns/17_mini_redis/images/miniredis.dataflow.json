      "label": "接入"
    },
    {
      "label": "并发"
    },
    {
      "label": "协议解析"
    },
    {
      "label": "命令分派"
    },
    {
      "label": "存储与回写"
    }
  ],
  "nodes": [
    {
      "id": "listener",
      "type": "backend",
      "label": "net.Listen + Accept",
      "sublabel": "阻塞等新连接",
      "stage": 0,
      "row": 1,
      "tag": "TCP"
    },
    {
      "id": "handleConn",
      "type": "backend",
      "label": "handleConn",
      "sublabel": "每连接 1 个 goroutine",
      "stage": 1,
      "row": 1,
      "tag": "C10K 模型"
    },
    {
      "id": "parser",
      "type": "backend",
      "label": "RESP-like 行解析",
      "sublabel": "ReadString→Fields",
      "stage": 2,
      "row": 1,
      "tag": "文本协议"
    },
    {
      "id": "dispatch",
      "type": "backend",
      "label": "executeCommand",
      "sublabel": "SET GET DEL EXPIRE TTL PING",
      "stage": 3,
      "row": 1,
      "tag": "switch 分派",
      "width": 160
    },
    {
      "id": "store",
      "type": "database",
      "label": "KVStore",
      "sublabel": "RWMutex + 两 map",
