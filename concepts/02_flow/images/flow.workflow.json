  "nodes": [
    {
      "id": "n_for",
      "lane": "loop",
      "col": 0,
      "type": "external",
      "label": "for i := 1; i <= 15; i++",
      "sublabel": "另有 while 式 / for range",
      "width": 172
    },
    {
      "id": "n_if",
      "lane": "loop",
      "col": 4,
      "type": "frontend",
      "label": "if r := i % 3; r == 0",
      "sublabel": "r 仅 if/else 内可见",
      "tag": "作用域最小化",
      "width": 150
    },
    {
      "id": "n_switch",
      "lane": "decide",
      "col": 1,
      "type": "backend",
      "label": "switch { 无表达式 }",
      "sublabel": "case 自上而下取首个 true",
      "width": 140
    },
    {
      "id": "n_c15",
      "lane": "decide",
      "col": 2,
      "type": "messagebus",
      "label": "case i%15 == 0",
      "sublabel": "→ \"FizzBuzz\"",
      "tag": "最先判·互斥",
      "width": 130
    },
    {
      "id": "n_c3",
      "lane": "decide",
      "col": 3,
