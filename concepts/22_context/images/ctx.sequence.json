  "activations": [],
  "cards": [
    {
      "dot": "cyan",
      "title": "心智模型",
      "items": [
        "context 是单向广播树：取消只从父流向子",
        "cancel/Done 是并发安全的，多次调用幂等",
        "超时只是\"到点自动 cancel\"，语义与手动一致"
      ]
    },
    {
      "dot": "rose",
      "title": "经典陷阱",
      "items": [
        "忘记 defer cancel()：ctx 泄漏，子 goroutine 永远阻塞",
        "拿 ctx.Value 传业务参数：它只放请求级元数据",
        "自己写 goroutine+channel 模拟取消：不如 Done 一次广播"
      ]
    },
    {
      "dot": "emerald",
      "title": "如何验证",
      "items": [
        "go run main.go：cancel 后子打印 context canceled 退出",
        "1.5s 超时打断 3s 任务，耗时约 1500ms",
        "第 4 节 WaitGroup 对账：子与孙都退出，程序不悬挂"
      ]
    }
  ]
}