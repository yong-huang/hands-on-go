    {
      "dot": "cyan",
      "title": "三个关键动作",
      "items": [
        "reflect.New(T) 造指针，Elem() 才可 Set",
        "指针值上 MethodByName 查到完整方法集",
        "Call 的参数与返回值都是 []reflect.Value"
      ]
    },
    {
      "dot": "orange",
      "title": "代价与风险",
      "items": [
        "反射调用比直接调用慢约一个数量级",
        "方法/字段名是字符串，编译期查不出错",
        "签名不匹配在运行时 panic，调用前先看 Type"
      ]
    },
    {
      "dot": "rose",
      "title": "典型用途",
      "items": [
        "插件系统：按名字调接口实现",
        "RPC/序列化框架动态派发",
        "还原为 Interface() 后可回到静态调用"
      ]
    }
  ]
