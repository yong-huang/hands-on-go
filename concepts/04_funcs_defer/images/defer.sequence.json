  "cards": [
    {
      "dot": "cyan",
      "title": "多返回值惯用法",
      "items": [
        "value, err 捆绑返回",
        "出错时值恒为零值，先判 err",
        "调用方在第一行就分流成功与失败"
      ]
    },
    {
      "dot": "orange",
      "title": "defer 三条铁律",
      "items": [
        "注册时求值参数，执行时才用",
        "执行顺序 LIFO：3 → 2 → 1",
        "panic 时 defer 仍然执行，是清理的兜底"
      ]
    },
    {
      "dot": "emerald",
      "title": "命名返回值与 recover",
      "items": [
        "ret 是具名变量，return 之后 defer 仍可改写",
        "recover 只在 defer 函数里生效",
        "捕获后函数正常返回，程序继续运行"
      ]
    }
  ]
