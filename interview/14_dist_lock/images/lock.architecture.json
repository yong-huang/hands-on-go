    {
      "dot": "cyan",
      "title": "互斥三要素",
      "items": [
        "NX：key 已存在则获取失败，保证互斥",
        "TTL（PX）：持锁方崩溃后自动过期，防死锁",
        "唯一 value（holder）：解锁前校验，防误删他人锁"
      ]
    },
